        {
          "id": "B",
          "text": {
            "ru": "Рефлекторным ориентировочным",
            "en": "Reflexive orienting",
            "kk": "Рефлекторлық бағдарлау зейініне"
          }
        },
        {
          "id": "C",
          "text": {
            "ru": "Произвольным моторным",
            "en": "Voluntary motor",
            "kk": "Ерікті моторлық зейінге"
          }
        },
        {
          "id": "D",
          "text": {
            "ru": "Непроизвольным двигательным",
            "en": "Involuntary motor",
            "kk": "Еріксіз қозғалыстық зейінге"
          }
        },
        {
          "id": "E",
          "text": {
            "ru": "Непроизвольным сенсорным",
            "en": "Involuntary sensory",
            "kk": "Еріксіз сенсорлық зейінге"
