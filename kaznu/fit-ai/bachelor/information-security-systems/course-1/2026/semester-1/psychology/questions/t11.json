    {
      "id": 222,
      "topic_id": 11,
      "difficulty_level": 3,
      "exam_block": 3,
      "type": "single_choice",
      "question": {
        "ru": "Что позволяет различать характер и темперамент при оценке поведения?",
        "en": "What makes it possible to distinguish character from temperament when evaluating behavior?",
        "kk": "Мінез-құлықты бағалау кезінде мінез бен темпераментті не ажыратуға мүмкіндік береді?"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "ru": "Темперамент однозначно задаёт правдивость",
            "en": "Temperament unambiguously determines truthfulness",
            "kk": "Темперамент шыншылдықты біржақты анықтайды"
          }
        },
        {
          "id": "B",
          "text": {
            "ru": "Характер определяет темп, темперамент систему ценностей",
            "en": "Character determines tempo, temperament the value system",
            "kk": "Мінез екпінді, темперамент құндылықтар жүйесін анықтайды"
          }
        },
        {
          "id": "C",
          "text": {
            "ru": "Характер врождён целиком, темперамент приобретается обучением",
            "en": "Character is entirely innate, temperament is acquired through learning",
            "kk": "Мінез толығымен туа біткен, темперамент оқыту арқылы жүре пайда болады"
          }
        },
        {
          "id": "D",
          "text": {
            "ru": "Характер не проявляется в деятельности",
            "en": "Character is not manifested in activity",
            "kk": "Мінез әрекетте көрінбейді"
          }
        },
        {
          "id": "E",
          "text": {
            "ru": "Характер выражает содержание отношений, темперамент их динамику",
            "en": "Character expresses the content of attitudes, temperament their dynamics",
            "kk": "Мінез қатынастардың мазмұнын, темперамент олардың динамикасын білдіреді"
          }
        }
      ],
      "correct_answers": [
        "E"
      ],
