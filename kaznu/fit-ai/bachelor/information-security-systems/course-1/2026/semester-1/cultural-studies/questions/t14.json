        },
        {
          "id": "C",
          "text": {
            "ru": "Отделение религии от государства и равноправие религий",
            "en": "The separation of religion from the state and the equality of religions",
            "kk": "Дінді мемлекеттен бөлу және діндердің тең құқығы"
          }
        },
        {
          "id": "D",
          "text": {
            "ru": "Государственная монополия одной религии и упразднение муфтията",
            "en": "A state monopoly of one religion and the abolition of the muftiate",
            "kk": "Бір діннің мемлекеттік монополиясы және муфтиятты тарату"
