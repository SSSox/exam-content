{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "exambank/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\/[a-z0-9-]+)*$"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "machine",
          "reviewed"
        ]
      }
    },
    "created_on": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty_scale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "required": [
          "level",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "multiple_choice": {
          "type": "string",
          "enum": [
            "exact",
            "partial"
          ]
        }
      },
      "required": [
        "multiple_choice"
      ],
      "additionalProperties": false
    },
    "exam": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "topics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": {}
      }
    },
    "sources": {
      "type": "array",
      "items": {}
    },
    "source_catalog": {
      "type": "array",
      "items": {}
    },
    "source_indexing": {},
    "notes": {},
    "legacy": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "id",
    "subject",
    "language",
    "scoring",
    "topics"
  ],
  "additionalProperties": false
}
